node_modules/
dist/
out/

# Built by scripts/build-web.mts, from src/. Generated rather than committed:
# it is a third of a megabyte of somebody else's minified code, and every npm
# script that needs it builds it first.
public/vendor/

# Compiled beside their sources by tsconfig.page.json, because the URLs the page is loaded by
# (backend.js, app.js, landing.js) are those names. public/host.js is hand-written and tracked.
public/app.js
public/backend.js
site/landing.js

# Copied into the landing page by scripts/build-site.mts, from assets/.
# Generated rather than committed for the same reason: they are bytes this
# repository already has, and a second copy is a second thing to remember to
# update. site/images/ held the og:image when that was a screenshot, and stays
# ignored so a checkout that built it then does not offer to commit it now.
site/images/
site/icon.svg
site/icon.png

shell/target/
shell/gen/schemas/
*.log
.DS_Store
.vscode/

# Notes and guides for working on this with an agent. They can live in a
# checkout without being part of the project; .gitignore does not touch a file
# that is already tracked, so a checkout that does track them is unaffected.
/.claude/
/skills/
/features/
/CLAUDE.md
/AGENT.md
/AGENTS.md
