{
  "name": "redline-preview",
  "displayName": "Redline",
  "description": "A Markdown preview that marks what changed since you last read it, with History and Contents.",
  "version": "0.0.0",
  "publisher": "redline",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onWebviewPanel:redline.preview"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Redline reads and diffs the files you open." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      { "command": "redline.open", "title": "Redline: Open Preview to the Side", "icon": "$(preview)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "redline.open", "when": "resourceLangId == markdown", "group": "navigation" }
      ],
      "explorer/context": [
        { "command": "redline.open", "when": "resourceLangId == markdown", "group": "navigation" }
      ],
      "commandPalette": [{ "command": "redline.open", "when": "editorLangId == markdown" }]
    }
  }
}
