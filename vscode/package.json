{
  "name": "redline-preview",
  "displayName": "Redline: spot what an AI agent edited in your docs",
  "description": "A Markdown preview that marks what changed since you last read it, with History and Contents.",
  "version": "0.0.4",
  "publisher": "tuanchauict",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuanchauict/redlineapp.git"
  },
  "homepage": "https://github.com/tuanchauict/redlineapp",
  "bugs": {
    "url": "https://github.com/tuanchauict/redlineapp/issues"
  },
  "keywords": [
    "markdown",
    "preview",
    "diff",
    "changes",
    "history",
    "review"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:redline.preview"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Redline reads and diffs the files you open."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "redline.open",
        "title": "Redline: Open Preview to the Side",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "redline.open",
          "when": "resourceLangId == markdown || resourceExtname =~ /\\.(md|markdown)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "redline.open",
          "when": "resourceLangId == markdown || resourceExtname =~ /\\.(md|markdown)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "redline.open",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.(md|markdown)$/"
        }
      ]
    }
  }
}
